+        private const val TAG = "TelephoneSkill"
+
+        private val SPEAKER_SUFFIX = Regex(
+            """\s*\b(?:in|con\s+il|con\s+l|col|con|nel|a)\s+(?:viva\s*voce|altoparlante)\s*$""",
+            RegexOption.IGNORE_CASE
+        )
+        private val SPEAKER_PREFIX = Regex(
+            """^\s*(?:in|con\s+il|col|con)\s+(?:viva\s*voce|altoparlante)\s+""",
+            RegexOption.IGNORE_CASE
+        )
+
+        /** Returns the contact name without the speakerphone words, and whether they were said. */
+        fun extractSpeakerphone(who: String): Pair<String, Boolean> {
+            var name = who
+            var speaker = false
+            SPEAKER_SUFFIX.find(name)?.let {
+                name = name.removeRange(it.range)
+                speaker = true
+            }
+            SPEAKER_PREFIX.find(name)?.let {
+                name = name.removeRange(it.range)
+                speaker = true
+            }
+            return Pair(name.trim(), speaker)
+        }
+
+        fun call(context: Context, number: String?) = call(context, number, false)
+
+        /**
+         * PATCH (Dicio per Claude): places the call through TelecomManager.placeCall (works also
+         * from the background), asking to start it with the speakerphone on if [speaker]. As a
+         * fallback, the speakerphone is also turned on through AudioManager once the call started.
+         */
+        fun call(context: Context, number: String?, speaker: Boolean) {
+            if (number == null) return
+            val uri = Uri.fromParts("tel", number, null)
+            var placed = false
+
+            val telecom = context.getSystemService(TelecomManager::class.java)
+            if (telecom != null && Build.VERSION.SDK_INT >= Build.VERSION_CODES.M &&
+                context.checkSelfPermission(Manifest.permission.CALL_PHONE) ==
+                PackageManager.PERMISSION_GRANTED
+            ) {
+                try {
+                    val extras = Bundle()
+                    extras.putBoolean(TelecomManager.EXTRA_START_CALL_WITH_SPEAKERPHONE, speaker)
+                    telecom.placeCall(uri, extras)
+                    placed = true
+                } catch (e: Exception) {
+                    Log.w(TAG, "placeCall failed, using ACTION_CALL", e)
+                }
+            }
+
+            if (!placed) {
+                val callIntent = Intent(Intent.ACTION_CALL, uri)
+                callIntent.flags = Intent.FLAG_ACTIVITY_NEW_TASK
+                callIntent.putExtra(TelecomManager.EXTRA_START_CALL_WITH_SPEAKERPHONE, speaker)
+                context.startActivity(callIntent)
+            }
+
+            if (speaker) {
+                scheduleSpeakerphoneFallback(context.applicationContext)
+            }
+        }
+
+        private fun scheduleSpeakerphoneFallback(context: Context) {
+            val handler = Handler(Looper.getMainLooper())
+            for (delay in longArrayOf(1500L, 3000L, 5000L, 8000L)) {
+                handler.postDelayed({ ensureSpeakerphone(context) }, delay)
+            }
+        }
+
+        @Suppress("DEPRECATION")
+        private fun ensureSpeakerphone(context: Context) {
+            try {
+                val am = context.getSystemService(AudioManager::class.java) ?: return
+                if (am.mode != AudioManager.MODE_IN_CALL &&
+                    am.mode != AudioManager.MODE_IN_COMMUNICATION) return
+                if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.S) {
+                    if (am.communicationDevice?.type == AudioDeviceInfo.TYPE_BUILTIN_SPEAKER) return
+                    val speakerDevice = am.availableCommunicationDevices
+                        .firstOrNull { it.type == AudioDeviceInfo.TYPE_BUILTIN_SPEAKER }
+                    if (speakerDevice != null && am.setCommunicationDevice(speakerDevice)) {
+                        Log.d(TAG, "Speakerphone turned on with setCommunicationDevice")
+                        return
+                    }
+                }
+                if (!am.isSpeakerphoneOn) {
+                    am.isSpeakerphoneOn = true
+                    Log.d(TAG, "Speakerphone turned on with setSpeakerphoneOn")
+                }
+            } catch (e: Exception) {
+                Log.w(TAG, "Could not turn on the speakerphone", e)
+            }
         }
     }
 }
