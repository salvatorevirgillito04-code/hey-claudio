@@ -0,0 +1,14 @@
+package org.stypox.dicio.io.wake
+
+/**
+ * PATCH (Dicio per Claude): Italian navigation requests, e.g. "portami a Roma",
+ * "naviga verso via Roma 10 Milano", "indicazioni per la stazione", "andiamo al lavoro".
+ */
+object Navigation {
+    private val START = Regex(
+        """^(?:portami|accompagnami|naviga(?:zione)?|avvia\s+(?:la\s+)?navigazione|andiamo|indicazioni(?:\s+stradali)?|percorso|strada)\s+(?:(?:verso|fino|per)\s+)?(?:all'|(?:alla|allo|alle|agli|ai|al|ad|a|in|dalla|dal|da)\s+)?(.+)$"""
+    )
+
+    fun parse(text: String): String? =
+        START.find(text.trim())?.groupValues?.get(1)?.trim()?.takeIf { it.isNotEmpty() }
+}
diff --git a/app/src/main/kotlin/org/stypox/dicio/io/wake/PhoneActions.kt b/app/src/main/kotlin/org/stypox/dicio/io/wake/PhoneActions.kt
new file mode 100644
index 00000000..e3251864
--- /dev/null
+++ b/app/src/main/kotlin/org/stypox/dicio/io/wake/PhoneActions.kt
@@ -0,0 +1,326 @@
+package org.stypox.dicio.io.wake
+
+import android.Manifest
+import android.content.Context
+import android.content.Intent
+import android.content.pm.PackageManager
+import android.net.Uri
+import android.provider.AlarmClock
+import android.provider.ContactsContract
+import android.telephony.PhoneNumberUtils
+import android.util.Log
+import org.stypox.dicio.skills.telephone.Contact
+import org.stypox.dicio.skills.telephone.TelephoneSkill
+import java.net.URLEncoder
+
+/**
+ * PATCH (Dicio per Claude): voice actions that Dicio does not have as skills: WhatsApp messages
+ * and WhatsApp (video) calls. Everything is in Italian, as transcribed by the offline STT (so
+ * without punctuation), e.g.:
+ * - "scrivi a Mario su whatsapp ciao come stai", "manda un messaggio a Mario dicendo arrivo"
+ * - "chiama Mario su whatsapp", "videochiama Mario"
+ */
+object PhoneActions {
+    private const val TAG = "PhoneActions"
+    const val WHATSAPP = "com.whatsapp"
+    const val WHATSAPP_BUSINESS = "com.whatsapp.w4b"
+    private fun voiceMime(pkg: String) = "vnd.android.cursor.item/vnd.$pkg.voip.call"
+    private fun videoMime(pkg: String) = "vnd.android.cursor.item/vnd.$pkg.video.call"
+
+    sealed interface Result {
+        /** Not a WhatsApp action: let Dicio's skills handle it. */
+        data object NotHandled : Result
+        /** Done; [speech] is said out loud if not null. */
+        data class Done(val speech: String?, val info: String? = null) : Result
+    }
+
+    private val WHATSAPP_WORDS = Regex("""\s*\b(?:su|con|via|tramite|in|di)\s+(?:whatsapp|whats\s*app|uozzap|uotsap)\b""")
+    private val MESSAGE_START = Regex(
+        """^(?:scrivi|scrivere|manda|mandare|invia|inviare|mandami|scrivimi)(?:\s+(?:un|il|questo|questa|sto)?\s*(?:messaggio|messaggino|whatsapp|vocale))?\s+(?:a|ad|al|alla|allo)\s+(.+)$"""
+    )
+    private val TEXT_SEPARATOR = Regex(
+        """\s+(?:che\s+dice|dicendo(?:gli|le)?|con\s+scritto|scrivendo(?:gli|le)?|con\s+il\s+testo|il\s+messaggio|messaggio)\s+"""
+    )
+    private val VIDEO_CALL = Regex("""^(?:videochiama|videochiamata\s+(?:a|ad|al|alla)|fai\s+una\s+videochiamata\s+(?:a|ad|al|alla))\s+(.+)$""")
+    private val CALL_START = Regex("""^(?:chiama|chiamami|telefona(?:\s+(?:a|ad|al|alla))?)\s+(.+)$""")
+
+    private val AUTO_SEND_SUFFIX = Regex("""\s+(?:e\s+)?(?:invia(?:lo|la)?|mandalo|mandala|spedisci(?:lo)?|invio)\s*$""")
+
+    fun handle(context: Context, rawText: String): Result {
+        val text = rawText.lowercase().trim()
+
+        Alarms.parse(text)?.let { return setAlarm(context, it) }
+        Navigation.parse(text)?.let { return navigate(context, it) }
+        val mentionsWhatsapp = text.contains("whatsapp") || text.contains("whats app")
+
+        VIDEO_CALL.find(text)?.let {
+            return whatsappCall(context, WHATSAPP_WORDS.replace(it.groupValues[1], " ").trim(), video = true)
+        }
+        if (mentionsWhatsapp) {
+            CALL_START.find(text)?.let {
+                val video = text.contains("video")
+                val who = WHATSAPP_WORDS.replace(it.groupValues[1], " ")
+                    .replace(Regex("""\b(?:in\s+)?video\b"""), " ").trim()
+                return whatsappCall(context, who, video)
+            }
+        }
+        val withoutWhatsapp = WHATSAPP_WORDS.replace(text, " ").replace(Regex("""\s+"""), " ").trim()
+        MESSAGE_START.find(withoutWhatsapp)?.let {
+            var rest = it.groupValues[1].trim()
+            val autoSend = AUTO_SEND_SUFFIX.containsMatchIn(rest)
+            rest = AUTO_SEND_SUFFIX.replace(rest, "").trim()
+            return whatsappMessage(context, rest, autoSend)
+        }
+        PHONE_CALL.find(text)?.let { return phoneCall(context, it.groupValues[1].trim()) }
+        OPEN_APP.find(text)?.let { return openApp(context, it.groupValues[1].trim()) }
+        return Result.NotHandled
+    }
+
+    private val PHONE_CALL = Regex(
+        """^(?:chiama|chiamami|chiamare|chiamate|telefona|telefonare|telefonagli|telefonale|telefonami)\s+(?:a\s+|ad\s+|al\s+|alla\s+|allo\s+)?(.+)$"""
+    )
+    private val OPEN_APP = Regex(
+        """^(?:apri|aprimi|avvia|lancia|esegui|vai\s+su)\s+(?:l'app\s+|la\s+app\s+|l\s+app\s+|app\s+|applicazione\s+|l'applicazione\s+)?(.+)$"""
+    )
+
+    private data class NamedContact(val name: String, val id: String)
+
+    private fun allContacts(context: Context): List<NamedContact> {
+        val list = ArrayList<NamedContact>()
+        context.contentResolver.query(
+            ContactsContract.Contacts.CONTENT_URI,
+            arrayOf(ContactsContract.Contacts._ID, ContactsContract.Contacts.DISPLAY_NAME),
+            "${ContactsContract.Contacts.HAS_PHONE_NUMBER} = 1", null, null
+        )?.use { c ->
+            while (c.moveToNext()) {
+                val id = c.getString(0) ?: continue
+                val name = c.getString(1) ?: continue
+                list.add(NamedContact(name, id))
+            }
+        }
+        return list
+    }
+
+    private fun numbersOf(context: Context, contactId: String): List<String> {
+        val list = ArrayList<String>()
+        context.contentResolver.query(
+            ContactsContract.CommonDataKinds.Phone.CONTENT_URI,
+            arrayOf(ContactsContract.CommonDataKinds.Phone.NUMBER),
+            "${ContactsContract.CommonDataKinds.Phone.CONTACT_ID} = ?", arrayOf(contactId), null
+        )?.use { c ->
+            while (c.moveToNext()) c.getString(0)?.let { list.add(it) }
+        }
+        return list.distinctBy { it.filter { ch -> ch.isDigit() } }
+    }
+
+    /** "chiama Mitch (in vivavoce)", done directly (not through Dicio's skill). */
+    private fun phoneCall(context: Context, rest: String): Result {
+        if (context.checkSelfPermission(Manifest.permission.READ_CONTACTS) !=
+            PackageManager.PERMISSION_GRANTED ||
+            context.checkSelfPermission(Manifest.permission.CALL_PHONE) !=
+            PackageManager.PERMISSION_GRANTED
+        ) {
+            return Result.Done("Per chiamare apri Dicio per Claude e consenti Contatti e Telefono")
+        }
+        val (who, speaker) = TelephoneSkill.extractSpeakerphone(rest)
+        if (who.isEmpty()) return Result.Done("Chi devo chiamare?")
+
+        val (contact, ties) = Fuzzy.best(who, allContacts(context), { it.name })
+        if (contact == null) {
+            return Result.Done(
+                if (ties.isEmpty()) "Non ho trovato $who nei contatti"
+                else "Ho trovato " + ties.take(3).joinToString(", ") { it.name } +
+                        ". Ripeti il comando con il nome completo"
+            )
+        }
+        val number = numbersOf(context, contact.id).firstOrNull()
+            ?: return Result.Done("${contact.name} non ha un numero di telefono")
+        Log.d(TAG, "Calling ${contact.name} speaker=$speaker")
+        TelephoneSkill.call(context, number, speaker)
+        return Result.Done(null, "Chiamo ${contact.name}" + if (speaker) " in vivavoce" else "")
+    }
+
+    /** "apri Instagram", with "sounds like" matching of the app name. */
+    private fun openApp(context: Context, name: String): Result {
+        val pm = context.packageManager
+        val apps = pm.queryIntentActivities(
+            Intent(Intent.ACTION_MAIN).addCategory(Intent.CATEGORY_LAUNCHER), 0
+        ).map { Pair(it.loadLabel(pm).toString(), it.activityInfo.packageName) }
+            .distinctBy { it.second }
+        // also match the words of the package name ("WA Business" is com.whatsapp.w4b)
+        val (app, ties) = Fuzzy.best(name, apps, { (label, pkg) ->
+            label + " " + pkg.split('.')
+                .filter { it !in setOf("com", "android", "app", "org", "net", "it", "mobile") }
+                .joinToString(" ")
+        })
+        if (app == null) {
+            return Result.Done(
+                if (ties.isEmpty()) "Non ho trovato l'app $name"
+                else "Quale app? " + ties.take(3).joinToString(", ") { it.first }
+            )
+        }
+        val intent = pm.getLaunchIntentForPackage(app.second)
+            ?.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
+            ?: return Result.Done("Non riesco ad aprire ${app.first}")
+        return try {
+            context.startActivity(intent)
+            Result.Done(null, "Apro ${app.first}")
+        } catch (e: Exception) {
+            Log.w(TAG, "Could not open ${app.second}", e)
+            Result.Done("Non riesco ad aprire ${app.first}")
+        }
+    }
+
+    private fun hasContactsPermission(context: Context) =
+        context.checkSelfPermission(Manifest.permission.READ_CONTACTS) ==
+                PackageManager.PERMISSION_GRANTED
+
+    /** WhatsApp, or else WhatsApp Business, or null if neither is installed. */
+    private fun whatsappPackage(context: Context): String? =
+        listOf(WHATSAPP, WHATSAPP_BUSINESS).firstOrNull {
+            try {
+                context.packageManager.getPackageInfo(it, 0)
+                true
+            } catch (e: Exception) {
+                false
+            }
+        }
+
+    /** Splits "mario rossi ciao come stai" into the best matching contact and the message. */
+    private fun splitContactAndText(context: Context, rest: String): Pair<Contact, String>? {
+        TEXT_SEPARATOR.find(rest)?.let { sep ->
+            val name = rest.substring(0, sep.range.first).trim()
+            val message = rest.substring(sep.range.last + 1).trim()
+            val contact = Contact.getFilteredSortedContacts(context.contentResolver, name)
+                .firstOrNull() ?: return null
+            return Pair(contact, message)
+        }
+
+        val words = rest.split(' ').filter { it.isNotEmpty() }
+        val candidates = (1..minOf(3, words.size)).mapNotNull { k ->
+            Contact.getFilteredSortedContacts(
+                context.contentResolver, words.take(k).joinToString(" ")
+            ).firstOrNull()?.let { Triple(k, it, it.distance) }
+        }
+        if (candidates.isEmpty()) return null
+        val bestDistance = candidates.minOf { it.third }
+        // the shortest name that matches about as well as the best one
+        val chosen = candidates.first { it.third <= bestDistance + 2 }
+        val message = words.drop(chosen.first).joinToString(" ")
+            .replace(Regex("""^(?:che|e|di|:)\s+"""), "")
+        return Pair(chosen.second, message.trim())
+    }
+
+    private fun whatsappMessage(context: Context, rest: String, autoSend: Boolean): Result {
+        if (!hasContactsPermission(context)) {
+            return Result.Done("Per scrivere messaggi devo poter leggere i contatti")
+        }
+        val waPackage = whatsappPackage(context) ?: return Result.Done("WhatsApp non è installato")
+        val (contact, message) = splitContactAndText(context, rest)
+            ?: return Result.Done("Non ho trovato nessun contatto con questo nome")
+        val number = contact.getNumbers(context.contentResolver).firstOrNull()
+            ?: return Result.Done("${contact.name} non ha un numero di telefono")
+
+        val international = (PhoneNumberUtils.formatNumberToE164(number, "IT") ?: number)
+            .filter { it.isDigit() }
+        var url = "https://api.whatsapp.com/send?phone=$international"
+        if (message.isNotEmpty()) {
+            url += "&text=" + URLEncoder.encode(message, "UTF-8").replace("+", "%20")
+        }
+        var speech: String? = null
+        if (autoSend && message.isNotEmpty()) {
+            if (WhatsAppSendService.isEnabled(context)) {
+                // the accessibility service will press "Invia" as soon as the chat is open
+                WhatsAppSendService.arm(context)
+            } else {
+                speech = "Per inviare da solo attiva Hey Claudio invio WhatsApp nelle impostazioni di accessibilità"
+            }
+        }
+        return try {
+            context.startActivity(
+                Intent(Intent.ACTION_VIEW, Uri.parse(url))
+                    .setPackage(waPackage)
+                    .addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
+            )
+            Result.Done(speech)
+        } catch (e: Exception) {
+            Log.w(TAG, "Could not open WhatsApp", e)
+            Result.Done("Non riesco ad aprire WhatsApp")
+        }
+    }
+
+    private fun setAlarm(context: Context, alarm: Alarms.Alarm): Result {
+        val intent = Intent(AlarmClock.ACTION_SET_ALARM)
+            .putExtra(AlarmClock.EXTRA_HOUR, alarm.hour)
+            .putExtra(AlarmClock.EXTRA_MINUTES, alarm.minute)
+            .putExtra(AlarmClock.EXTRA_SKIP_UI, true)
+            .addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
+        if (alarm.label != null) intent.putExtra(AlarmClock.EXTRA_MESSAGE, alarm.label)
+        return try {
+            context.startActivity(intent)
+            Result.Done("Sveglia impostata alle ${alarm.hour} e ${"%02d".format(alarm.minute)}")
+        } catch (e: Exception) {
+            Log.w(TAG, "Could not set alarm", e)
+            Result.Done("Non riesco a impostare la sveglia")
+        }
+    }
+
+    private fun navigate(context: Context, destination: String): Result {
+        val maps = Intent(Intent.ACTION_VIEW, Uri.parse("google.navigation:q=" + Uri.encode(destination)))
+            .setPackage("com.google.android.apps.maps")
+            .addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
+        return try {
+            context.startActivity(maps)
+            Result.Done(null)
+        } catch (e: Exception) {
+            try {
+                context.startActivity(
+                    Intent(Intent.ACTION_VIEW, Uri.parse("geo:0,0?q=" + Uri.encode(destination)))
+                        .addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
+                )
+                Result.Done(null)
+            } catch (e2: Exception) {
+                Log.w(TAG, "Could not start navigation", e2)
+                Result.Done("Non ho trovato un'app per la navigazione")
+            }
+        }
+    }
+
+    private fun whatsappCall(context: Context, who: String, video: Boolean): Result {
+        if (!hasContactsPermission(context)) {
+            return Result.Done("Per chiamare su WhatsApp devo poter leggere i contatti")
+        }
+        val waPackage = whatsappPackage(context) ?: return Result.Done("WhatsApp non è installato")
+        val contacts = Contact.getFilteredSortedContacts(context.contentResolver, who)
+        val mimeType = if (video) videoMime(waPackage) else voiceMime(waPackage)
+
+        for (contact in contacts.take(5)) {
+            val dataId = context.contentResolver.query(
+                ContactsContract.Data.CONTENT_URI,
+                arrayOf(ContactsContract.Data._ID),
+                "${ContactsContract.Data.CONTACT_ID} = ? AND ${ContactsContract.Data.MIMETYPE} = ?",
+                arrayOf(contact.id, mimeType),
+                null
+            )?.use { c -> if (c.moveToFirst()) c.getLong(0) else null } ?: continue
+
+            return try {
+                context.startActivity(
+                    Intent(Intent.ACTION_VIEW)
+                        .setDataAndType(
+                            Uri.parse("content://com.android.contacts/data/$dataId"), mimeType
+                        )
+                        .setPackage(waPackage)
+                        .addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
+                )
+                Result.Done(null)
+            } catch (e: Exception) {
+                Log.w(TAG, "Could not start WhatsApp call", e)
+                Result.Done("Non riesco a chiamare su WhatsApp")
+            }
+        }
+        return Result.Done(
+            if (contacts.isEmpty()) "Non ho trovato nessun contatto con questo nome"
+            else "${contacts[0].name} non ha WhatsApp nei contatti"
+        )
+    }
+}
diff --git a/app/src/main/kotlin/org/stypox/dicio/io/wake/WakeRestart.kt b/app/src/main/kotlin/org/stypox/dicio/io/wake/WakeRestart.kt
new file mode 100644
index 00000000..c578f293
--- /dev/null
+++ b/app/src/main/kotlin/org/stypox/dicio/io/wake/WakeRestart.kt
@@ -0,0 +1,125 @@
+package org.stypox.dicio.io.wake
+
+import android.Manifest.permission.RECORD_AUDIO
+import android.app.Activity
+import android.app.AlarmManager
+import android.app.PendingIntent
+import android.content.BroadcastReceiver
+import android.content.Context
+import android.content.Intent
+import android.content.pm.PackageManager
+import android.os.Build
+import android.os.Bundle
+import android.os.Handler
+import android.os.Looper
+import android.os.SystemClock
+import android.util.Log
+import androidx.core.content.ContextCompat
+
+/**
+ * PATCH (Dicio per Claude): keeps "Hey Claudio" listening even after ColorOS kills the app (e.g.
+ * when it is closed from the recent apps).
+ *
+ * Android does not let an app in the background turn the microphone on, so restarting the
+ * [WakeService] goes through [WakeRestartActivity], an invisible activity: while it is shown the
+ * app is in the foreground, and the service can be started with access to the microphone.
+ */
+object WakeRestart {
+    private const val TAG = "WakeRestart"
+    private const val PREFS = "dicio_per_claude"
+    private const val KEY_STOPPED_BY_USER = "wake_stopped_by_user"
+    private const val ALARM_REQUEST_CODE = 7301
+    const val ACTION_RESTART = "org.stypox.dicio.io.wake.WakeService.ACTION_RESTART"
