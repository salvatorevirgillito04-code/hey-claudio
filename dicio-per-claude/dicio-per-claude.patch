+
+            if (speaker) {
+                scheduleSpeakerphoneFallback(context.applicationContext)
+            }
+        }
+
+        private fun scheduleSpeakerphoneFallback(context: Context) {
+            val handler = Handler(Looper.getMainLooper())
+            for (delay in longArrayOf(1500L, 3000L, 5000L, 8000L)) {
+                handler.postDelayed({ ensureSpeakerphone(context) }, delay)
+            }
+        }
+
+        @Suppress("DEPRECATION")
+        private fun ensureSpeakerphone(context: Context) {
+            try {
+                val am = context.getSystemService(AudioManager::class.java) ?: return
+                if (am.mode != AudioManager.MODE_IN_CALL &&
+                    am.mode != AudioManager.MODE_IN_COMMUNICATION) return
+                if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.S) {
+                    if (am.communicationDevice?.type == AudioDeviceInfo.TYPE_BUILTIN_SPEAKER) return
+                    val speakerDevice = am.availableCommunicationDevices
+                        .firstOrNull { it.type == AudioDeviceInfo.TYPE_BUILTIN_SPEAKER }
+                    if (speakerDevice != null && am.setCommunicationDevice(speakerDevice)) {
+                        Log.d(TAG, "Speakerphone turned on with setCommunicationDevice")
+                        return
+                    }
+                }
+                if (!am.isSpeakerphoneOn) {
+                    am.isSpeakerphoneOn = true
+                    Log.d(TAG, "Speakerphone turned on with setSpeakerphoneOn")
+                }
+            } catch (e: Exception) {
+                Log.w(TAG, "Could not turn on the speakerphone", e)
+            }
         }
     }
 }
