@@ -0,0 +1,60 @@
+package org.stypox.dicio.io.wake
+
+import android.app.SearchManager
+import android.content.Context
+import android.os.Build
+import android.os.Bundle
+import android.provider.Settings
+import android.util.Log
+import org.lsposed.hiddenapibypass.HiddenApiBypass
+
+/**
+ * PATCH (Dicio per Claude): opens the default digital assistant (Claude) exactly like a long press
+ * of the power button does, i.e. Claude's voice assistant panel shown over the current screen,
+ * also over the lock screen.
+ *
+ * It calls SearchManager.launchAssist(), which is a hidden API: the system service behind it
+ * (SearchManagerService.launchAssist -> StatusBarManagerInternal.startAssist) does not require
+ * any permission, but the method is hidden from normal apps, so HiddenApiBypass is used.
+ */
+object ClaudeAssist {
+    private const val TAG = "ClaudeAssist"
+
+    /**
+     * Returns true if Claude is the default digital assistant, false if another app is, null if
+     * it could not be determined.
+     */
+    fun isClaudeDefaultAssistant(context: Context): Boolean? {
+        for (key in listOf("assistant", "voice_interaction_service")) {
+            try {
+                val value = Settings.Secure.getString(context.contentResolver, key)
+                if (!value.isNullOrEmpty()) {
+                    return value.startsWith(ClaudeTrampolineActivity.CLAUDE_PACKAGE + "/")
+                }
+            } catch (e: Throwable) {
+                Log.w(TAG, "Cannot read secure setting $key", e)
+            }
+        }
+        return null
+    }
+
+    /** Returns true if the system accepted the request to show the assistant. */
+    fun launch(context: Context): Boolean {
+        return try {
+            val searchManager =
+                context.getSystemService(Context.SEARCH_SERVICE) as SearchManager
+            val args = Bundle()
+            if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.P) {
+                HiddenApiBypass.invoke(SearchManager::class.java, searchManager, "launchAssist", args)
+            } else {
+                SearchManager::class.java.getMethod("launchAssist", Bundle::class.java)
+                    .invoke(searchManager, args)
+            }
+            Log.d(TAG, "launchAssist called")
+            true
+        } catch (e: Throwable) {
+            Log.w(TAG, "launchAssist failed", e)
+            false
+        }
+    }
+}
