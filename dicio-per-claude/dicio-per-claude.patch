+package org.stypox.dicio.io.wake
+
+import android.accessibilityservice.AccessibilityService
+import android.content.Intent
+import android.util.Log
+import android.view.accessibility.AccessibilityEvent
+
+/**
+ * Dicio per Claude: an accessibility service whose only job is to allow opening Claude
+ * from the background when the wake word is heard (Android blocks background activity
+ * starts, but apps with a bound accessibility service are exempt). It reads nothing.
+ */
+class ClaudeLauncherService : AccessibilityService() {
+    override fun onServiceConnected() {
+        super.onServiceConnected()
+        instance = this
+    }
+
+    override fun onAccessibilityEvent(event: AccessibilityEvent?) {}
+
+    override fun onInterrupt() {}
+
+    override fun onDestroy() {
+        if (instance === this) instance = null
+        super.onDestroy()
+    }
+
+    override fun onUnbind(intent: Intent?): Boolean {
+        if (instance === this) instance = null
+        return super.onUnbind(intent)
+    }
+
+    companion object {
+        @Volatile
+        var instance: ClaudeLauncherService? = null
+
+        fun tryStart(intent: Intent): Boolean {
+            val service = instance ?: return false
+            return try {
+                service.startActivity(intent)
+                true
+            } catch (e: Exception) {
+                Log.w("ClaudeLauncherService", "Could not start Claude", e)
+                false
+            }
+        }
+    }
+}
