+
+/**
+ * PATCH (Dicio per Claude): keeps "Hey Claudio" listening even after ColorOS kills the app (e.g.
+ * when it is closed from the recent apps).
+ *
+ * Android does not let an app in the background turn the microphone on, so restarting the
+ * [WakeService] goes through [WakeRestartActivity], an invisible activity: while it is shown the
+ * app is in the foreground, and the service can be started with access to the microphone.
+ */
+object WakeRestart {
+    private const val TAG = "WakeRestart"
+    private const val PREFS = "dicio_per_claude"
+    private const val KEY_STOPPED_BY_USER = "wake_stopped_by_user"
+    private const val ALARM_REQUEST_CODE = 7301
+    const val ACTION_RESTART = "org.stypox.dicio.io.wake.WakeService.ACTION_RESTART"
+    const val AFTER_TASK_REMOVED_DELAY_MILLIS = 3000L
+    const val WATCHDOG_INTERVAL_MILLIS = 1000L * 60 * 15 // 15 minutes
+
+    fun setStoppedByUser(context: Context, stopped: Boolean) {
+        context.getSharedPreferences(PREFS, Context.MODE_PRIVATE).edit()
+            .putBoolean(KEY_STOPPED_BY_USER, stopped).apply()
+        if (stopped) cancelAlarm(context)
+    }
+
+    fun isStoppedByUser(context: Context): Boolean =
+        context.getSharedPreferences(PREFS, Context.MODE_PRIVATE)
+            .getBoolean(KEY_STOPPED_BY_USER, false)
+
+    private fun alarmIntent(context: Context): PendingIntent =
+        PendingIntent.getBroadcast(
+            context,
+            ALARM_REQUEST_CODE,
+            Intent(context, WakeRestartReceiver::class.java),
+            PendingIntent.FLAG_IMMUTABLE or PendingIntent.FLAG_UPDATE_CURRENT
+        )
+
+    /** Schedules a check (and restart if needed) of the wake word service after [delayMillis]. */
+    fun scheduleCheck(context: Context, delayMillis: Long) {
+        if (isStoppedByUser(context)) return
+        try {
+            val am = context.getSystemService(AlarmManager::class.java) ?: return
+            val at = SystemClock.elapsedRealtime() + delayMillis
+            if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.M) {
+                if (Build.VERSION.SDK_INT < Build.VERSION_CODES.S || am.canScheduleExactAlarms()) {
+                    am.setExactAndAllowWhileIdle(
+                        AlarmManager.ELAPSED_REALTIME_WAKEUP, at, alarmIntent(context))
+                } else {
+                    am.setAndAllowWhileIdle(
+                        AlarmManager.ELAPSED_REALTIME_WAKEUP, at, alarmIntent(context))
+                }
+            } else {
+                am.set(AlarmManager.ELAPSED_REALTIME_WAKEUP, at, alarmIntent(context))
+            }
+        } catch (e: Exception) {
+            Log.w(TAG, "Could not schedule restart check", e)
+        }
+    }
+
+    private fun cancelAlarm(context: Context) {
+        try {
+            context.getSystemService(AlarmManager::class.java)?.cancel(alarmIntent(context))
+        } catch (e: Exception) {
+            Log.w(TAG, "Could not cancel restart check", e)
+        }
+    }
+
+    fun canRun(context: Context): Boolean =
+        !isStoppedByUser(context) &&
+                ContextCompat.checkSelfPermission(context, RECORD_AUDIO) ==
+                PackageManager.PERMISSION_GRANTED
+}
+
+/** Fired by the alarm: makes sure the wake word service is running. */
+class WakeRestartReceiver : BroadcastReceiver() {
+    override fun onReceive(context: Context, intent: Intent?) {
+        if (!WakeRestart.canRun(context)) return
+        // periodic watchdog, in case the app gets killed without notice
+        WakeRestart.scheduleCheck(context, WakeRestart.WATCHDOG_INTERVAL_MILLIS)
+        try {
+            // a plain (not foreground) start, allowed thanks to the "allow while idle" alarm;
+            // the service will then restart itself through WakeRestartActivity if needed
+            context.startService(
+                Intent(context, WakeService::class.java).setAction(WakeRestart.ACTION_RESTART))
+        } catch (e: Exception) {
+            Log.w("WakeRestartReceiver", "Could not start WakeService", e)
+        }
+    }
+}
+
+/** Invisible activity: starting the service from here gives it access to the microphone. */
+class WakeRestartActivity : Activity() {
+    override fun onCreate(savedInstanceState: Bundle?) {
+        super.onCreate(savedInstanceState)
+        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O_MR1) {
+            setShowWhenLocked(true)
+        }
+        try {
+            WakeService.start(this)
+        } catch (e: Exception) {
+            Log.w("WakeRestartActivity", "Could not start WakeService", e)
+        }
+        Handler(Looper.getMainLooper()).postDelayed({
+            finish()
+            @Suppress("DEPRECATION")
+            overridePendingTransition(0, 0)
+        }, 600L)
+    }
+}
