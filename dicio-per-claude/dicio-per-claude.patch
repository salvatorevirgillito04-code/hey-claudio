@@ -0,0 +1,67 @@
+package org.stypox.dicio.io.wake
+
+import java.text.Normalizer
+
+/**
+ * PATCH (Dicio per Claude): "sounds like" matching for names said by voice and transcribed by the
+ * offline STT, which often gets them wrong ("apripista in gran" for "apri Instagram",
+ * "mich" for "Mitch"). Compares letters only, ignoring spaces and accents.
+ */
+object Fuzzy {
+    fun normalize(s: String): String =
+        Normalizer.normalize(s.lowercase(), Normalizer.Form.NFD)
+            .replace(Regex("""[^a-z0-9]"""), "")
+
+    private fun levenshtein(a: String, b: String): Int {
+        var prev = IntArray(b.length + 1) { it }
+        for (i in 1..a.length) {
+            val cur = IntArray(b.length + 1)
+            cur[0] = i
+            for (j in 1..b.length) {
+                cur[j] = minOf(
+                    prev[j] + 1, cur[j - 1] + 1,
+                    prev[j - 1] + if (a[i - 1] == b[j - 1]) 0 else 1
+                )
+            }
+            prev = cur
+        }
+        return prev[b.length]
+    }
+
+    /** 1.0 = same, 0.0 = completely different. */
+    fun similarity(said: String, name: String): Double {
+        val a = normalize(said)
+        if (a.isEmpty()) return 0.0
+        var best = 0.0
+        // the whole name, and each of its words ("Mitch Rossi" -> "mitch", "rossi")
+        val variants = listOf(name) + name.split(Regex("""\s+""")).filter { it.length > 1 }
+        for (variant in variants) {
+            val b = normalize(variant)
+            if (b.isEmpty()) continue
+            var sim = 1.0 - levenshtein(a, b).toDouble() / maxOf(a.length, b.length)
+            // "whatsapp" -> "WhatsApp Business"
+            if (b.length >= 3 && a.length >= 3 && (b.startsWith(a) || a.startsWith(b))) {
+                sim = maxOf(sim, 0.7)
+            }
+            best = maxOf(best, sim)
+        }
+        return best
+    }
+
+    /** The best item if it is similar enough and clearly better than the second one. */
+    fun <T> best(
+        said: String,
+        items: List<T>,
+        name: (T) -> String,
+        minSimilarity: Double = 0.45,
+    ): Pair<T?, List<T>> {
+        val scored = items.map { Pair(it, similarity(said, name(it))) }
+            .filter { it.second >= minSimilarity }
+            .sortedByDescending { it.second }
+        if (scored.isEmpty()) return Pair(null, emptyList())
+        val top = scored[0]
+        val ties = scored.filter { top.second - it.second < 0.08 }.map { it.first }
+        return if (ties.size == 1 || top.second >= 0.99) Pair(top.first, ties)
+        else Pair(null, ties) // ambiguous
+    }
+}
