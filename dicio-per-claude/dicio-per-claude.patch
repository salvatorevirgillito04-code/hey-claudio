+++ b/app/src/main/kotlin/org/stypox/dicio/io/wake/Alarms.kt
@@ -0,0 +1,103 @@
+package org.stypox.dicio.io.wake
+
+import java.time.LocalTime
+
+/**
+ * PATCH (Dicio per Claude): understands Italian alarm requests as transcribed by the offline STT
+ * (numbers may be digits or words), e.g. "metti una sveglia alle sette e mezza",
+ * "svegliami alle 6:45", "sveglia alle otto di sera", "sveglia tra venti minuti".
+ */
+object Alarms {
+    data class Alarm(val hour: Int, val minute: Int, val label: String?)
+
+    private val START = Regex(
+        """^(?:(?:metti|mettimi|imposta|impostami|crea|fissa|punta)\s+(?:una|la)?\s*sveglia|sveglia|svegliami|sveglieri[ae])\b\s*(.*)$"""
+    )
+
+    private val UNITS = mapOf(
+        "zero" to 0, "un" to 1, "uno" to 1, "una" to 1, "l'una" to 1, "due" to 2, "tre" to 3,
+        "quattro" to 4, "cinque" to 5, "sei" to 6, "sette" to 7, "otto" to 8, "nove" to 9,
+        "dieci" to 10, "undici" to 11, "dodici" to 12, "tredici" to 13, "quattordici" to 14,
+        "quindici" to 15, "sedici" to 16, "diciassette" to 17, "diciotto" to 18,
+        "diciannove" to 19, "mezzogiorno" to 12, "mezzanotte" to 0,
+    )
+    private val TENS = listOf("venti" to 20, "trenta" to 30, "quaranta" to 40, "cinquanta" to 50)
+    private val UNIT_SUFFIX = mapOf(
+        "" to 0, "uno" to 1, "un" to 1, "due" to 2, "tre" to 3, "tré" to 3, "quattro" to 4,
+        "cinque" to 5, "sei" to 6, "sette" to 7, "otto" to 8, "nove" to 9,
+    )
+
+    /** Parses "7", "07", "sette", "ventitré", "trentacinque"... */
+    fun parseNumber(word: String): Int? {
+        word.toIntOrNull()?.let { return it }
+        UNITS[word]?.let { return it }
+        for ((tensWord, tens) in TENS) {
+            // "ventuno"/"ventotto": the final vowel of the tens is dropped
+            for (prefix in listOf(tensWord, tensWord.dropLast(1))) {
+                if (word.startsWith(prefix)) {
+                    UNIT_SUFFIX[word.removePrefix(prefix)]?.let { return tens + it }
+                }
+            }
+        }
+        return null
+    }
+
+    fun parse(text: String): Alarm? {
+        val rest = START.find(text.trim())?.groupValues?.get(1)?.trim() ?: return null
+        val words = rest.replace(":", " ").replace(".", " ").split(Regex("""\s+"""))
+            .filter { it.isNotEmpty() }
+
+        // "tra venti minuti" / "fra un'ora" / "tra due ore e mezza"
+        val traIndex = words.indexOfFirst { it == "tra" || it == "fra" }
+        if (traIndex >= 0) {
+            var minutes = 0
+            var i = traIndex + 1
+            while (i < words.size) {
+                val w = words[i].removePrefix("un'")
+                val n = if (words[i].startsWith("un'")) 1 else parseNumber(w)
+                val unitWord = if (words[i].startsWith("un'")) w else words.getOrNull(i + 1) ?: ""
+                if (n != null && unitWord.startsWith("or")) { minutes += n * 60; i += if (words[i].startsWith("un'")) 1 else 2; continue }
+                if (n != null && unitWord.startsWith("minut")) { minutes += n; i += 2; continue }
+                if (w == "mezza" || w == "mezzo") { minutes += 30; i++; continue }
+                if (w == "e") { i++; continue }
+                break
+            }
+            if (minutes > 0) {
+                val t = LocalTime.now().plusMinutes(minutes.toLong())
+                return Alarm(t.hour, t.minute, null)
+            }
+        }
+
+        // "alle sette e mezza (di sera)", "per le 6 45", "alle 7"
+        var i = words.indexOfFirst { it == "alle" || it == "all'una" || it == "per" || it == "a" }
+        if (words.getOrNull(i) == "per" && words.getOrNull(i + 1) == "le") i++
+        val hourIndex = if (i >= 0) i + 1 else 0
+        val hourWord = if (words.getOrNull(i) == "all'una") "una" else words.getOrNull(hourIndex)
+        var hour = hourWord?.let { parseNumber(it) } ?: return null
+        if (hour > 24) return null
+        var minute = 0
+        var j = if (words.getOrNull(i) == "all'una") i + 1 else hourIndex + 1
+        if (words.getOrNull(j) == "e") j++
+        when (val w = words.getOrNull(j)) {
+            "mezza", "mezzo", "trenta" -> { minute = 30; j++ }
+            "un" -> if (words.getOrNull(j + 1) == "quarto") { minute = 15; j += 2 }
+            "meno" -> {
+                if (words.getOrNull(j + 1) == "un" && words.getOrNull(j + 2) == "quarto") {
+                    minute = 45; hour = (hour + 23) % 24; j += 3
+                } else {
+                    parseNumber(words.getOrNull(j + 1) ?: "")?.let {
+                        minute = (60 - it) % 60; hour = (hour + 23) % 24; j += 2
+                    }
+                }
+            }
+            null -> {}
+            else -> parseNumber(w)?.let { if (it < 60) { minute = it; j++ } }
+        }
+        if (words.getOrNull(j) == "minuti") j++
+        val tail = words.drop(j).joinToString(" ")
+        if (hour < 12 && (tail.contains("sera") || tail.contains("pomeriggio"))) hour += 12
+        if (hour == 12 && (tail.contains("notte"))) hour = 0
+        if (hour == 24) hour = 0
+        return Alarm(hour, minute, null)
+    }
+}
