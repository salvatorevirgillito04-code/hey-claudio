@@ -0,0 +1,135 @@
+package org.stypox.dicio.io.wake
+
+import android.app.Activity
+import android.app.KeyguardManager
+import android.app.NotificationManager
+import android.content.Context
+import android.content.Intent
+import android.os.Build
+import android.os.Bundle
+import android.util.Log
+import android.view.WindowManager
+import android.widget.Toast
+
+/**
+ * PATCH (Dicio per Claude): invisible activity started when "Hey Claudio" is heard.
+ *
+ * Being an activity of ours that can be shown over the lock screen and that turns the screen on,
+ * it works both with the screen on and with the screen off/locked:
+ * 1. it wakes up the screen and shows itself over the lock screen;
+ * 2. if the phone is locked, it asks the system to unlock it (face/fingerprint/PIN, or nothing at
+ *    all if the lock is just a swipe);
+ * 3. once unlocked (or immediately, if it was not locked) it opens Claude, which is allowed
+ *    because this activity is in the foreground.
+ */
+class ClaudeTrampolineActivity : Activity() {
+
+    private var claudeStarted = false
+
+    override fun onCreate(savedInstanceState: Bundle?) {
+        super.onCreate(savedInstanceState)
+        showOverLockScreen()
+
+        val now = System.currentTimeMillis()
+        if (now - lastLaunchMillis < DUPLICATE_LAUNCH_MILLIS) {
+            // both the overlay start and the full screen notification may arrive: ignore the second
+            Log.d(TAG, "Ignoring duplicate launch")
+            finish()
+            return
+        }
+        lastLaunchMillis = now
+
+        getSystemService(NotificationManager::class.java)
+            ?.cancel(WakeService.TRIGGERED_NOTIFICATION_ID)
+
+        val keyguard = getSystemService(Context.KEYGUARD_SERVICE) as KeyguardManager
+        if (keyguard.isKeyguardLocked && Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) {
+            keyguard.requestDismissKeyguard(this, object : KeyguardManager.KeyguardDismissCallback() {
+                override fun onDismissSucceeded() {
+                    openClaude()
+                }
+
+                override fun onDismissCancelled() {
+                    Log.d(TAG, "Unlock cancelled")
+                    finish()
+                }
+
+                override fun onDismissError() {
+                    Log.w(TAG, "Unlock error, trying to open Claude anyway")
+                    openClaude()
+                }
+            })
+        } else {
+            openClaude()
+        }
+    }
+
+    private fun showOverLockScreen() {
+        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O_MR1) {
+            setShowWhenLocked(true)
+            setTurnScreenOn(true)
+        } else {
+            @Suppress("DEPRECATION")
+            window.addFlags(
+                WindowManager.LayoutParams.FLAG_SHOW_WHEN_LOCKED or
+                        WindowManager.LayoutParams.FLAG_TURN_SCREEN_ON or
+                        WindowManager.LayoutParams.FLAG_DISMISS_KEYGUARD
+            )
+        }
+        window.addFlags(WindowManager.LayoutParams.FLAG_KEEP_SCREEN_ON)
+    }
+
+    private fun openClaude() {
+        if (claudeStarted) return
+        claudeStarted = true
+
+        val intent = buildClaudeIntent(this)
+        if (intent == null) {
+            Toast.makeText(this, "App Claude non trovata", Toast.LENGTH_LONG).show()
+            finish()
+            return
+        }
+
+        try {
+            startActivity(intent)
+        } catch (e: Exception) {
+            Log.e(TAG, "Could not open Claude", e)
+            Toast.makeText(this, "Impossibile aprire Claude: ${e.message}", Toast.LENGTH_LONG).show()
+        }
+        finish()
+        @Suppress("DEPRECATION")
+        overridePendingTransition(0, 0)
+    }
+
+    companion object {
+        private const val TAG = "ClaudeTrampoline"
+        private const val DUPLICATE_LAUNCH_MILLIS = 3000L
+        const val CLAUDE_PACKAGE = "com.anthropic.claude"
+
+        @Volatile
+        private var lastLaunchMillis = 0L
+
+        /**
+         * Tries, in order: the assistant entry point (ACTION_ASSIST, used by the system when
+         * Claude is the default digital assistant), the voice command entry point, then the normal
+         * launcher activity of Claude.
+         */
+        fun buildClaudeIntent(context: Context): Intent? {
+            val pm = context.packageManager
+            val candidates = listOf(
+                Intent(Intent.ACTION_ASSIST).setPackage(CLAUDE_PACKAGE),
+                Intent(Intent.ACTION_VOICE_COMMAND).setPackage(CLAUDE_PACKAGE),
+            )
+            for (candidate in candidates) {
+                if (candidate.resolveActivity(pm) != null) {
+                    return candidate.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
+                }
+            }
+            return pm.getLaunchIntentForPackage(CLAUDE_PACKAGE)
+                ?.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
+        }
+
+        fun isClaudeInstalled(context: Context): Boolean =
+            buildClaudeIntent(context) != null
+    }
+}
