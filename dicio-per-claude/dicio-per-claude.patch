+    private fun askNextClaudePermission() {
+        val pkg = android.net.Uri.parse("package:$packageName")
+        val steps = mutableListOf<Triple<String, () -> Boolean, Intent>>()
+        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.M) {
+            steps += Triple(
+                "Attiva \"Mostra sopra altre app\" per aprire Claude con Hey Claudio",
+                { android.provider.Settings.canDrawOverlays(this) },
+                Intent(android.provider.Settings.ACTION_MANAGE_OVERLAY_PERMISSION, pkg)
+            )
+        }
+        if (Build.VERSION.SDK_INT >= 34) {
+            steps += Triple(
+                "Consenti le notifiche a schermo intero: servono ad aprire Claude a schermo spento",
+                {
+                    getSystemService(android.app.NotificationManager::class.java)
+                        ?.canUseFullScreenIntent() != false
+                },
+                Intent(android.provider.Settings.ACTION_MANAGE_APP_USE_FULL_SCREEN_INTENT, pkg)
+            )
+        }
+        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.M) {
+            steps += Triple(
+                "Consenti l'uso in background senza limiti, così Hey Claudio funziona a schermo spento",
+                {
+                    getSystemService(android.os.PowerManager::class.java)
+                        ?.isIgnoringBatteryOptimizations(packageName) != false
+                },
+                Intent(android.provider.Settings.ACTION_REQUEST_IGNORE_BATTERY_OPTIMIZATIONS, pkg)
+            )
+        }
+
+        for ((message, isGranted, intent) in steps) {
+            if (isGranted() || message in claudePermissionsAsked) continue
+            claudePermissionsAsked += message
+            android.widget.Toast.makeText(this, message, android.widget.Toast.LENGTH_LONG).show()
+            try {
+                startActivity(intent)
+            } catch (e: Exception) {
+                Log.w(TAG, "Could not open permission settings", e)
+                continue
+            }
+            return
+        }
     }
 
