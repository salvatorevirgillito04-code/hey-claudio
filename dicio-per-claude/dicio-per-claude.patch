+package org.stypox.dicio.io.wake
+
+import android.accessibilityservice.AccessibilityService
+import android.content.Context
+import android.content.Intent
+import android.os.Bundle
+import android.os.Handler
+import android.os.Looper
+import android.speech.tts.TextToSpeech
+import android.util.Log
+import android.view.accessibility.AccessibilityEvent
+import android.view.accessibility.AccessibilityNodeInfo
+import java.util.Locale
+
+/**
+ * PATCH (Dicio per Claude): accessibility service "Hey Claudio" (the class name is kept from
+ * the first version, so that users do not have to enable it again). It does two things, and only
+ * right after a voice command:
+ * - presses "Invia" in WhatsApp after "... e invia" ([arm]);
+ * - writes a question in the Claude app, sends it and reads the answer out loud ([askClaude]).
+ * It only looks at WhatsApp and Claude windows and never stores anything.
+ */
+class WhatsAppSendService : AccessibilityService(), TextToSpeech.OnInitListener {
+
+    private val handler = Handler(Looper.getMainLooper())
+    private var tts: TextToSpeech? = null
+    private var ttsReady = false
+
+    override fun onServiceConnected() {
+        super.onServiceConnected()
+        instance = this
+        tts = TextToSpeech(this, this)
+    }
+
+    override fun onInit(status: Int) {
+        if (status == TextToSpeech.SUCCESS) {
+            tts?.language = Locale.ITALIAN
+            ttsReady = true
+        }
+    }
+
+    override fun onDestroy() {
+        if (instance === this) instance = null
+        tts?.shutdown()
+        super.onDestroy()
+    }
+
+    override fun onAccessibilityEvent(event: AccessibilityEvent?) {
+        val root = rootInActiveWindow ?: return
+        val pkg = root.packageName?.toString() ?: return
+        if (pkg.startsWith("com.whatsapp")) {
+            onWhatsAppEvent(root)
+        } else if (pkg == CLAUDE_PACKAGE) {
+            onClaudeEvent(root)
+        }
+    }
+
+    override fun onInterrupt() {}
+
+    // ---------------------------------------- WhatsApp ----------------------------------------
+
+    private fun onWhatsAppEvent(root: AccessibilityNodeInfo) {
+        if (!isArmed(this)) return
+        val button = findWhatsAppSendButton(root) ?: return
+        if (clickNodeOrParent(button)) {
+            Log.d(TAG, "Pressed Invia in WhatsApp")
+            disarm(this)
+        }
+    }
+
+    // ----------------------------------------- Claude -----------------------------------------
+
+    private enum class Stage { NONE, SENDING, WAITING_ANSWER }
+
+    private var stage = Stage.NONE
+    private var question = ""
+    private var deadline = 0L
+    private var lastAnswer = ""
+    private var lastChange = 0L
+    private var lastSetTextAttempt = 0L
+
+    private fun startQuestion(q: String) {
+        question = q
+        stage = Stage.SENDING
+        deadline = System.currentTimeMillis() + SEND_TIMEOUT_MILLIS
+        lastAnswer = ""
+        tts?.stop()
+        handler.removeCallbacks(checkAnswerRunnable)
+        handler.postDelayed(sendingTimeoutRunnable, SEND_TIMEOUT_MILLIS)
+    }
+
+    private val sendingTimeoutRunnable = Runnable {
+        if (stage == Stage.SENDING) {
+            Log.w(TAG, "Could not send the question to Claude")
+            stage = Stage.NONE
+            speak("Non sono riuscito a scrivere la domanda a Claude")
+        }
+    }
+
+    private fun onClaudeEvent(root: AccessibilityNodeInfo) {
+        when (stage) {
+            Stage.NONE -> {}
+            Stage.SENDING -> trySendQuestion(root)
+            Stage.WAITING_ANSWER -> updateAnswer(root)
+        }
+    }
+
+    private fun trySendQuestion(root: AccessibilityNodeInfo) {
+        val input = findEditable(root) ?: return
+        val current = input.text?.toString() ?: ""
+        if (!normalize(current).contains(normalize(question).take(15))) {
+            val now = System.currentTimeMillis()
+            if (now - lastSetTextAttempt < 500) return
+            lastSetTextAttempt = now
+            input.performAction(AccessibilityNodeInfo.ACTION_FOCUS)
+            val args = Bundle()
+            args.putCharSequence(
+                AccessibilityNodeInfo.ACTION_ARGUMENT_SET_TEXT_CHARSEQUENCE, question)
+            input.performAction(AccessibilityNodeInfo.ACTION_SET_TEXT, args)
+            return // wait for the next event, so that the send button gets enabled
+        }
+        val send = findByDescription(root, SEND_DESCRIPTIONS) ?: return
+        if (clickNodeOrParent(send)) {
+            Log.d(TAG, "Question sent to Claude")
+            handler.removeCallbacks(sendingTimeoutRunnable)
+            stage = Stage.WAITING_ANSWER
+            deadline = System.currentTimeMillis() + ANSWER_TIMEOUT_MILLIS
+            lastAnswer = ""
+            lastChange = System.currentTimeMillis()
+            handler.postDelayed(checkAnswerRunnable, CHECK_INTERVAL_MILLIS)
+        }
+    }
+
+    private fun updateAnswer(root: AccessibilityNodeInfo) {
+        val answer = extractAnswer(root)
+        if (answer != lastAnswer) {
+            lastAnswer = answer
+            lastChange = System.currentTimeMillis()
+        }
+    }
+
+    private val checkAnswerRunnable: Runnable = object : Runnable {
+        override fun run() {
+            if (stage != Stage.WAITING_ANSWER) return
+            rootInActiveWindow?.takeIf { it.packageName == CLAUDE_PACKAGE }?.let { root ->
+                updateAnswer(root)
+                val generating = findByDescription(root, STOP_DESCRIPTIONS) != null
+                val now = System.currentTimeMillis()
+                if (lastAnswer.isNotBlank() && !generating &&
+                    now - lastChange >= ANSWER_STABLE_MILLIS) {
+                    stage = Stage.NONE
+                    Log.d(TAG, "Reading Claude's answer")
+                    speak(lastAnswer)
+                    return
+                }
+            }
+            if (System.currentTimeMillis() > deadline) {
+                stage = Stage.NONE
+                if (lastAnswer.isNotBlank()) speak(lastAnswer)
+                return
+            }
+            handler.postDelayed(this, CHECK_INTERVAL_MILLIS)
+        }
+    }
+
+    /** All the texts shown after the last occurrence of the question, i.e. Claude's answer. */
+    private fun extractAnswer(root: AccessibilityNodeInfo): String {
+        val texts = ArrayList<Pair<String, Boolean>>() // text, is it a button / editable
+        collectTexts(root, texts, 0)
+        val q = normalize(question).take(25)
+        val questionIndex = texts.indexOfLast { normalize(it.first).contains(q) }
+        if (questionIndex < 0) return ""
+        return texts.drop(questionIndex + 1)
+            .filter { (text, isControl) ->
+                !isControl && text.length > 1 && IGNORED_TEXTS.none { text.contains(it, true) }
+            }
+            .joinToString("\n") { it.first }
+            .trim()
+    }
+
+    private fun collectTexts(
+        node: AccessibilityNodeInfo,
+        out: MutableList<Pair<String, Boolean>>,
+        depth: Int
+    ) {
+        if (depth > 60) return
+        val text = node.text?.toString()
+        if (!text.isNullOrBlank()) {
+            out.add(Pair(text, node.isEditable || node.isClickable && text.length < 25))
+        }
+        for (i in 0 until node.childCount) {
+            node.getChild(i)?.let { collectTexts(it, out, depth + 1) }
+        }
+    }
+
+    private fun speak(text: String) {
+        if (!ttsReady) {
+            Log.w(TAG, "TTS not ready")
+            return
+        }
+        // long answers are split, TextToSpeech has a maximum length
+        val max = TextToSpeech.getMaxSpeechInputLength() - 1
+        text.chunked(max).forEachIndexed { i, chunk ->
+            tts?.speak(
+                chunk,
+                if (i == 0) TextToSpeech.QUEUE_FLUSH else TextToSpeech.QUEUE_ADD,
+                null,
+                "claude$i"
+            )
+        }
+    }
+
+    companion object {
+        private const val TAG = "HeyClaudioAccessibility"
+        const val CLAUDE_PACKAGE = "com.anthropic.claude"
+        private const val PREFS = "whatsapp_send"
+        private const val KEY = "armed_until"
+        private const val VALID_MILLIS = 20_000L
+        private const val SEND_TIMEOUT_MILLIS = 20_000L
+        private const val ANSWER_TIMEOUT_MILLIS = 90_000L
+        private const val ANSWER_STABLE_MILLIS = 2_500L
+        private const val CHECK_INTERVAL_MILLIS = 700L
+        private val WHATSAPP_SEND_IDS = listOf("com.whatsapp:id/send", "com.whatsapp.w4b:id/send")
+        private val SEND_DESCRIPTIONS = listOf(
+            "Invia", "Send", "Invia messaggio", "Send message", "Send Message"
+        )
+        private val STOP_DESCRIPTIONS = listOf(
+            "Stop", "Interrompi", "Ferma", "Stop response", "Stop generating", "Interrompi risposta"
+        )
+        private val IGNORED_TEXTS = listOf(
+            "può commettere errori", "can make mistakes", "Rispondi a Claude", "Reply to Claude",
+            "Scrivi a Claude", "Write a message", "Message Claude",
+        )
+
+        @Volatile
+        private var instance: WhatsAppSendService? = null
+
+        fun arm(context: Context) {
+            context.getSharedPreferences(PREFS, Context.MODE_PRIVATE).edit()
+                .putLong(KEY, System.currentTimeMillis() + VALID_MILLIS).apply()
+        }
+
+        private fun isArmed(context: Context) = System.currentTimeMillis() <
+                context.getSharedPreferences(PREFS, Context.MODE_PRIVATE).getLong(KEY, 0L)
+
+        private fun disarm(context: Context) {
+            context.getSharedPreferences(PREFS, Context.MODE_PRIVATE).edit().putLong(KEY, 0L).apply()
+        }
+
+        /** True if the user enabled this accessibility service. */
+        fun isEnabled(context: Context): Boolean {
+            val enabled = android.provider.Settings.Secure.getString(
+                context.contentResolver,
+                android.provider.Settings.Secure.ENABLED_ACCESSIBILITY_SERVICES
+            ) ?: return false
+            return enabled.split(':').any {
+                it.startsWith(context.packageName + "/") && it.endsWith("WhatsAppSendService")
+            }
+        }
+
+        /**
+         * Opens Claude with [question] already written (the "share" entry point, or else the
+         * normal one): the service then sends it and reads the answer. Main thread only.
+         */
+        fun askClaude(context: Context, question: String): Boolean {
+            val service = instance ?: return false
+            service.startQuestion(question)
+            val pm = context.packageManager
+            val share = Intent(Intent.ACTION_SEND)
+                .setType("text/plain")
+                .putExtra(Intent.EXTRA_TEXT, question)
+                .setPackage(CLAUDE_PACKAGE)
+                .addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
+            val intent = if (share.resolveActivity(pm) != null) share
+            else pm.getLaunchIntentForPackage(CLAUDE_PACKAGE)?.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
+            if (intent == null) return false
+            return try {
+                context.startActivity(intent)
+                true
+            } catch (e: Exception) {
+                Log.w(TAG, "Could not open Claude", e)
+                false
+            }
+        }
+
+        private fun normalize(s: String) =
+            s.lowercase().replace(Regex("""[^\p{L}\p{N}]+"""), " ").trim()
+
+        private fun findEditable(root: AccessibilityNodeInfo): AccessibilityNodeInfo? {
+            if (root.isEditable && root.isVisibleToUser) return root
+            for (i in 0 until root.childCount) {
+                root.getChild(i)?.let { child -> findEditable(child)?.let { return it } }
+            }
+            return null
+        }
+
+        private fun findByDescription(
+            root: AccessibilityNodeInfo,
+            descriptions: List<String>
+        ): AccessibilityNodeInfo? {
+            val desc = root.contentDescription?.toString()
+            if (desc != null && root.isVisibleToUser && root.isEnabled &&
+                descriptions.any { desc.equals(it, ignoreCase = true) }) return root
+            for (i in 0 until root.childCount) {
+                root.getChild(i)?.let { child ->
+                    findByDescription(child, descriptions)?.let { return it }
+                }
+            }
+            return null
+        }
+
+        private fun findWhatsAppSendButton(root: AccessibilityNodeInfo): AccessibilityNodeInfo? {
+            for (id in WHATSAPP_SEND_IDS) {
+                root.findAccessibilityNodeInfosByViewId(id)
+                    ?.firstOrNull { it.isVisibleToUser && it.isEnabled }
+                    ?.let { return it }
+            }
+            return findByDescription(root, listOf("Invia", "Send"))
+        }
+
+        private fun clickNodeOrParent(node: AccessibilityNodeInfo): Boolean {
+            var current: AccessibilityNodeInfo? = node
+            repeat(3) {
+                val c = current ?: return false
+                if (c.isClickable) return c.performAction(AccessibilityNodeInfo.ACTION_CLICK)
+                current = c.parent
+            }
+            return false
+        }
