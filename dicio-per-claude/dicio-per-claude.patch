+        }
+        try {
+            WakeService.start(this)
+        } catch (e: Exception) {
+            Log.w("WakeRestartActivity", "Could not start WakeService", e)
+        }
+        Handler(Looper.getMainLooper()).postDelayed({
+            finish()
+            @Suppress("DEPRECATION")
+            overridePendingTransition(0, 0)
+        }, 600L)
+    }
