<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.stypox.dicio.claude.invio"
    android:versionCode="105"
    android:versionName="1.105" >

    <uses-sdk
        android:minSdkVersion="26"
        android:targetSdkVersion="35" />

    <!--
         Same permission as in Dicio per Claude: only apps signed with the same key can ask this
         app to press "Invia"
    -->
    <permission
        android:name="org.stypox.dicio.claude.permission.WHATSAPP_SEND"
        android:protectionLevel="signature" />

    <queries>
        <package android:name="com.whatsapp" />
        <package android:name="com.whatsapp.w4b" />
    </queries>

    <application
        android:allowBackup="false"
        android:extractNativeLibs="false"
        android:icon="@android:drawable/ic_menu_send"
        android:label="@string/app_name" >
        <activity
            android:name="org.stypox.dicio.claude.invio.SetupActivity"
            android:exported="true" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name="org.stypox.dicio.claude.invio.SendRequestReceiver"
            android:exported="true"
            android:permission="org.stypox.dicio.claude.permission.WHATSAPP_SEND" >
            <intent-filter>
                <action android:name="org.stypox.dicio.claude.invio.SEND_NEXT" />
            </intent-filter>
        </receiver>

        <service
            android:name="org.stypox.dicio.claude.invio.WhatsAppSendService"
            android:exported="false"
            android:label="@string/service_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE" >
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>

            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service" />
        </service>
    </application>

</manifest>